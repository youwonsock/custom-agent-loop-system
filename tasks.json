{
  "$schema": "./tasks.schema.json",
  "schemaVersion": 1,
  "tasks": [
    {
      "id": "produce_plan",
      "runner": "agent",
      "description": "Produce three complete implementation choices for the fixed requirements.",
      "expectedOutput": "Three distinct plans, each covering every requirement ID.",
      "inputSchemaId": "task_input.produce_plan.v1",
      "resultSchemaId": "task_result.produce_plan.v1",
      "allowedSignals": ["success"],
      "sideEffect": "none",
      "toolPolicy": { "workspace": "read", "webSearch": true, "mcpServers": [] },
      "guardrails": [
        { "id": "known_requirement_ids" },
        { "id": "plan_choices", "config": { "expectedCount": 3 } }
      ],
      "effectMapper": "record_plan_choices",
      "retryPolicy": { "maxAttempts": 3, "formatRecoveryAttempts": 1, "backoffMs": [5000, 30000] }
    },
    {
      "id": "implement_changes",
      "runner": "agent",
      "description": "Implement the selected approved plan in the target workspace.",
      "expectedOutput": "Changed files, focused verification observations, notes, and evidence for every requirement.",
      "inputSchemaId": "task_input.implement_changes.v1",
      "resultSchemaId": "task_result.implement_changes.v1",
      "allowedSignals": ["success"],
      "sideEffect": "workspace_mutation",
      "toolPolicy": { "workspace": "write", "webSearch": true, "mcpServers": [] },
      "guardrails": [{ "id": "complete_requirement_evidence" }],
      "effectMapper": "record_implementation",
      "retryPolicy": { "maxAttempts": 3, "formatRecoveryAttempts": 1, "backoffMs": [5000, 30000] }
    },
    {
      "id": "run_tests",
      "runner": "agent",
      "description": "Independently create missing tests when necessary and run acceptance checks.",
      "expectedOutput": "Observed commands, pass/fail verdict, failures, and evidence for every requirement.",
      "inputSchemaId": "task_input.run_tests.v1",
      "resultSchemaId": "task_result.run_tests.v1",
      "allowedSignals": ["pass", "fail"],
      "sideEffect": "workspace_mutation",
      "toolPolicy": { "workspace": "write", "webSearch": false, "mcpServers": [] },
      "guardrails": [
        { "id": "complete_requirement_evidence" },
        { "id": "signal_matches_payload", "config": { "field": "verdict" } }
      ],
      "effectMapper": "record_test_result",
      "retryPolicy": { "maxAttempts": 2, "formatRecoveryAttempts": 1, "backoffMs": [5000] }
    },
    {
      "id": "audit_quality",
      "runner": "agent",
      "description": "Audit implementation and test evidence without changing files.",
      "expectedOutput": "Approved/rejected decision, concrete findings, and evidence for every requirement.",
      "inputSchemaId": "task_input.audit_quality.v1",
      "resultSchemaId": "task_result.audit_quality.v1",
      "allowedSignals": ["approved", "rejected"],
      "sideEffect": "none",
      "toolPolicy": { "workspace": "read", "webSearch": false, "mcpServers": [] },
      "guardrails": [
        { "id": "complete_requirement_evidence" },
        { "id": "signal_matches_payload", "config": { "field": "decision" } },
        { "id": "approval_requires_satisfied_evidence" }
      ],
      "effectMapper": "record_quality_audit",
      "retryPolicy": { "maxAttempts": 2, "formatRecoveryAttempts": 1, "backoffMs": [5000] }
    },
    {
      "id": "approve_completion",
      "runner": "agent",
      "description": "Make the final acceptance decision for the original goal.",
      "expectedOutput": "Approved/rejected decision with fresh evidence and rationale.",
      "inputSchemaId": "task_input.approve_completion.v1",
      "resultSchemaId": "task_result.approve_completion.v1",
      "allowedSignals": ["approved", "rejected"],
      "sideEffect": "none",
      "toolPolicy": { "workspace": "read", "webSearch": false, "mcpServers": [] },
      "guardrails": [
        { "id": "complete_requirement_evidence" },
        { "id": "signal_matches_payload", "config": { "field": "decision" } },
        { "id": "approval_requires_satisfied_evidence" }
      ],
      "effectMapper": "record_completion_approval",
      "retryPolicy": { "maxAttempts": 2, "formatRecoveryAttempts": 1, "backoffMs": [5000] }
    },
    {
      "id": "analyze_interrupt",
      "runner": "agent",
      "description": "Produce a bounded factual briefing after retry exhaustion, security blocking, or oscillation.",
      "expectedOutput": "Facts, failure briefing, and one concrete recovery action.",
      "inputSchemaId": "task_input.analyze_interrupt.v1",
      "resultSchemaId": "task_result.analyze_interrupt.v1",
      "allowedSignals": ["success"],
      "sideEffect": "none",
      "toolPolicy": { "workspace": "read", "webSearch": false, "mcpServers": [] },
      "guardrails": [{ "id": "known_requirement_ids" }],
      "effectMapper": "record_interrupt_briefing",
      "retryPolicy": { "maxAttempts": 1, "formatRecoveryAttempts": 1, "backoffMs": [] }
    }
  ]
}
