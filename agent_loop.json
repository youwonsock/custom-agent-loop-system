{
  "$schema": "./agent_loop.schema.json",
  "version": 1,
  "name": "autonomous-mutual-verification",
  "startStageId": "PLANNING",
  "interruptStageId": "INTERRUPT",
  "reentryStageId": "IMPLEMENTATION",
  "iterationCompletionStageId": "VERIFICATION",
  "stageTypes": [
    { "id": "planning", "label": "Planning", "executor": "planning", "completionContract": "plan_options", "description": "Produces selectable plan options and waits for approval when configured." },
    { "id": "implementation", "label": "Implementation", "executor": "implementation", "completionContract": "phase_done", "description": "Applies cumulative changes to the target project." },
    { "id": "test", "label": "Test", "executor": "test", "completionContract": "verdict", "description": "Runs independent tests and returns a PASS or FAIL verdict." },
    { "id": "review", "label": "Review", "executor": "review", "completionContract": "approval", "description": "Reviews prior evidence and returns APPROVED or REJECTED." },
    { "id": "approval", "label": "Approval", "executor": "approval", "completionContract": "approval", "description": "Makes the final goal-completion decision." },
    { "id": "interrupt", "label": "Interrupt", "executor": "interrupt", "completionContract": "phase_done", "description": "Produces a bounded failure briefing and stops the loop." }
  ],
  "stages": [
    { "id": "PLANNING", "name": "Planning", "role": "planner", "kind": "planning", "instructions": "", "onSuccess": "IMPLEMENTATION", "onFailure": "INTERRUPT", "countsIteration": false, "requiresPlanApproval": true, "planOptionsCount": 3 },
    { "id": "IMPLEMENTATION", "name": "Implementation", "role": "implementer", "kind": "implementation", "instructions": "", "onSuccess": "TEST_GENERATION", "onFailure": "INTERRUPT", "countsIteration": true, "requiresPlanApproval": false, "planOptionsCount": 0 },
    { "id": "TEST_GENERATION", "name": "Test generation and execution", "role": "tester", "kind": "test", "instructions": "", "onSuccess": "VERIFICATION", "onFailure": "VERIFICATION", "countsIteration": false, "requiresPlanApproval": false, "planOptionsCount": 0 },
    { "id": "VERIFICATION", "name": "Independent QA verification", "role": "qa_lead", "kind": "review", "instructions": "", "onSuccess": "MASTER_APPROVAL", "onFailure": "IMPLEMENTATION", "countsIteration": false, "requiresPlanApproval": false, "planOptionsCount": 0 },
    { "id": "MASTER_APPROVAL", "name": "Final approval", "role": "master", "kind": "approval", "instructions": "", "onSuccess": "SUCCESS", "onFailure": "IMPLEMENTATION", "countsIteration": false, "requiresPlanApproval": false, "planOptionsCount": 0 },
    { "id": "INTERRUPT", "name": "Failure briefing", "role": "interrupter", "kind": "interrupt", "instructions": "", "onSuccess": "PAUSED", "onFailure": "PAUSED", "countsIteration": false, "requiresPlanApproval": false, "planOptionsCount": 0 }
  ]
}
