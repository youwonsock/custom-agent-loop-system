{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Loop Definition",
  "type": "object",
  "required": ["version", "name", "startStageId", "interruptStageId", "reentryStageId", "iterationCompletionStageId", "stageTypes", "stages"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "name": { "type": "string", "minLength": 1 },
    "startStageId": { "$ref": "#/$defs/id" },
    "interruptStageId": { "$ref": "#/$defs/id" },
    "reentryStageId": { "$ref": "#/$defs/id" },
    "iterationCompletionStageId": { "$ref": "#/$defs/id" },
    "stageTypes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "executor", "completionContract", "description"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "label": { "type": "string", "minLength": 1 },
          "executor": { "enum": ["planning", "implementation", "test", "review", "approval", "interrupt"] },
          "completionContract": { "enum": ["phase_done", "plan_options", "verdict", "approval"] },
          "description": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "role", "kind", "instructions", "onSuccess", "onFailure", "countsIteration", "requiresPlanApproval", "planOptionsCount"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "name": { "type": "string", "minLength": 1 },
          "role": { "$ref": "#/$defs/id" },
          "kind": { "$ref": "#/$defs/id" },
          "instructions": { "type": "string" },
          "onSuccess": { "type": "string", "minLength": 1 },
          "onFailure": { "type": "string", "minLength": 1 },
          "countsIteration": { "type": "boolean" },
          "requiresPlanApproval": { "type": "boolean" },
          "planOptionsCount": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$" }
  },
  "additionalProperties": false
}
