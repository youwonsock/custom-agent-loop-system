{
  "name": "custom-agent-loop-system",
  "version": "8.0.0",
  "description": "Deterministic Agent-Task workflow orchestrator with typed graph transitions, checkpoints, and multi-provider coding runtimes.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/youwonsock/Custom_AgentLoopSystem.git"
  },
  "bugs": {
    "url": "https://github.com/youwonsock/Custom_AgentLoopSystem/issues"
  },
  "homepage": "https://github.com/youwonsock/Custom_AgentLoopSystem#readme",
  "type": "commonjs",
  "main": "dist/core/entrypoints/loop-orchestrator.js",
  "bin": {
    "agent-loop": "dist/core/entrypoints/loop-orchestrator.js"
  },
  "files": [
    "dist/core/**/*.js",
    "!dist/core/**/*.test.js",
    "config/*.json",
    "scripts/runtime/fix-pty-permissions.js",
    "native/bin/win32-x64/verification-host.exe",
    "native/bin/win32-x64/verification-host.manifest.json"
  ],
  "scripts": {
    "prebuild": "node scripts/build/sync-runtime-defaults.js && node scripts/build/clean-build.js",
    "build": "tsc -p tsconfig.json",
    "build:tests": "tsc -p tsconfig.tests.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && npm run build:tests && node scripts/test-support/run-node-tests.js --directory .build/test-dist",
    "coverage": "npm run build && npm run build:tests && node scripts/test-support/run-node-tests.js --directory .build/test-dist --coverage",
    "evaluate:langgraph": "npm --prefix experiments/langgraph ci --ignore-scripts && npm --prefix experiments/langgraph run evaluate",
    "conformance:provider": "npm run build && node dist/core/tools/provider-conformance.js",
    "smoke": "npm run build && node dist/core/entrypoints/loop-orchestrator.js --help",
    "bundle:desktop-core": "npm run build && node scripts/build/bundle-core-for-desktop.js",
    "package:npm": "npm run build && node scripts/package/package-npm-artifact.js",
    "package:desktop": "npm run bundle:desktop-core && npm --prefix desktop-app ci && npm --prefix desktop-app run package:portable && node scripts/package/package-desktop-artifact.js",
    "run:desktop": "npm run package:desktop && node scripts/package/run-desktop-portable.js",
    "verify:npm-artifact": "node scripts/verify/verify-npm-package.js",
    "pack:check": "npm run package:npm && npm run sbom:npm-artifact && npm run verify:npm-artifact",
    "verify:desktop": "node scripts/verify/verify-desktop-package.js",
    "checksum:artifacts": "node scripts/package/checksum-artifacts.js",
    "verify:release-bundle": "node scripts/verify/verify-release-bundle.js",
    "sbom": "node scripts/package/generate-sbom.js",
    "sbom:npm-artifact": "node scripts/package/generate-sbom.js --artifact-directory artifacts/npm",
    "generated:check": "node scripts/verify/check-generated-files.js && node scripts/verify/check-layout-boundary.js && node scripts/verify/check-lifecycle-names.js && node scripts/verify/check-legacy-boundary.js",
    "prestart": "npm run build",
    "start": "node dist/core/entrypoints/loop-orchestrator.js",
    "preinit": "npm run build",
    "init": "node dist/core/entrypoints/loop-orchestrator.js init",
    "prepack": "npm run build",
    "postinstall": "node scripts/runtime/fix-pty-permissions.js",
    "build:e2e": "npm --prefix desktop-app run build:e2e",
    "test:desktop": "playwright test"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@openai/codex": "^0.146.1",
    "fs-extra": "^11.4.0",
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.1.2",
    "c8": "10.1.3",
    "@playwright/test": "1.62.1",
    "typescript": "^7.0.2",
    "yauzl": "^3.4.0"
  }
}
