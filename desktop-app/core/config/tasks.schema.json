{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://custom-agent-loop.local/v7/tasks.schema.json",
  "title": "Task definitions",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "tasks"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "runner", "description", "expectedOutput", "inputSchemaId", "resultSchemaId",
          "allowedSignals", "sideEffect", "guardrails", "retryPolicy"
        ],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "runner": { "const": "agent" },
          "description": { "type": "string", "minLength": 1 },
          "expectedOutput": { "type": "string", "minLength": 1 },
          "inputSchemaId": { "type": "string", "minLength": 1 },
          "resultSchemaId": { "type": "string", "minLength": 1 },
          "allowedSignals": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": { "$ref": "#/$defs/id" }
          },
          "sideEffect": { "enum": ["none", "workspace_mutation"] },
          "toolPolicy": { "$ref": "#/$defs/narrowingToolPolicy" },
          "guardrails": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false, "required": ["id"],
              "properties": { "id": { "$ref": "#/$defs/id" }, "config": { "type": "object" } }
            }
          },
          "effectMapper": { "$ref": "#/$defs/id" },
          "retryPolicy": {
            "type": "object", "additionalProperties": false,
            "required": ["maxAttempts", "formatRecoveryAttempts", "backoffMs"],
            "properties": {
              "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 20 },
              "formatRecoveryAttempts": { "enum": [0, 1] },
              "backoffMs": {
                "type": "array", "maxItems": 19,
                "items": { "type": "integer", "minimum": 0, "maximum": 3600000 }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$" },
    "narrowingToolPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workspace": { "enum": ["none", "read", "write"] },
        "webSearch": { "type": "boolean" },
        "mcpServers": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
      }
    }
  }
}
