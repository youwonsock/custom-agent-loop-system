{
  "name": "custom-agent-loop-system",
  "version": "7.0.0",
  "description": "Deterministic Agent-Task workflow orchestrator with typed graph transitions, checkpoints, and multi-provider coding runtimes.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/youwonsock/Custom_AgentLoopSystem.git"
  },
  "bugs": {
    "url": "https://github.com/youwonsock/Custom_AgentLoopSystem/issues"
  },
  "homepage": "https://github.com/youwonsock/Custom_AgentLoopSystem#readme",
  "type": "commonjs",
  "main": "dist/loop_orchestrator.js",
  "bin": {
    "agent-loop": "dist/loop_orchestrator.js"
  },
  "files": [
    "dist/**/*.js",
    "!dist/**/*.test.js",
    "dist/**/*.json",
    "agents.json",
    "agents.schema.json",
    "tasks.json",
    "tasks.schema.json",
    "workflow.json",
    "workflow.schema.json",
    "loop_config.json",
    "loop_config.schema.json",
    "protocol_contract.json",
    "runtime_defaults.json",
    "scripts/fix-pty-permissions.js",
    "native/bin/win32-x64/verification-host.exe",
    "native/bin/win32-x64/verification-host.manifest.json"
  ],
  "scripts": {
    "prebuild": "node scripts/sync-runtime-defaults.js && node scripts/clean-build.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node scripts/run-node-tests.js",
    "coverage": "npm run build && node scripts/run-node-tests.js --coverage",
    "evaluate:langgraph": "npm --prefix experiments/langgraph ci --ignore-scripts && npm --prefix experiments/langgraph run evaluate",
    "conformance:provider": "npm run build && node dist/provider_conformance.js",
    "smoke": "npm run build && node dist/loop_orchestrator.js --help",
    "bundle:desktop-core": "npm run build && node scripts/bundle-core-for-desktop.js",
    "package:npm": "npm run build && node scripts/package-npm-artifact.js",
    "package:desktop": "npm run bundle:desktop-core && npm --prefix desktop-app ci && npm --prefix desktop-app run package:portable && node scripts/package-desktop-artifact.js",
    "run:desktop": "npm run package:desktop && node scripts/run-desktop-portable.js",
    "verify:npm-artifact": "node scripts/verify-npm-package.js",
    "pack:check": "npm run package:npm && npm run sbom:npm-artifact && npm run verify:npm-artifact",
    "verify:desktop": "node scripts/verify-desktop-package.js",
    "checksum:artifacts": "node scripts/checksum-artifacts.js",
    "verify:release-bundle": "node scripts/verify-release-bundle.js",
    "sbom": "node scripts/generate-sbom.js",
    "sbom:npm-artifact": "node scripts/generate-sbom.js --artifact-directory artifacts/npm",
    "generated:check": "node scripts/check-generated-files.js && node scripts/check-lifecycle-names.js && node scripts/check-legacy-boundary.js",
    "prestart": "npm run build",
    "start": "node dist/loop_orchestrator.js",
    "preinit": "npm run build",
    "init": "node dist/loop_orchestrator.js init",
    "prepack": "npm run build",
    "postinstall": "node scripts/fix-pty-permissions.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@openai/codex": "^0.146.1",
    "fs-extra": "^11.4.0",
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.1.2",
    "c8": "10.1.3",
    "typescript": "^7.0.2",
    "yauzl": "^3.4.0"
  }
}
