{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://custom-agent-loop.local/v7/agents.schema.json",
  "title": "Agent definitions",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "agents"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "objective", "instructions", "runtimeDefaults", "access", "toolPolicy"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "role": { "type": "string", "minLength": 1 },
          "objective": { "type": "string", "minLength": 1 },
          "instructions": { "type": "string" },
          "runtimeDefaults": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "provider": { "$ref": "#/$defs/id" },
              "model": { "type": "string", "minLength": 1 },
              "variant": { "type": "string", "minLength": 1 }
            }
          },
          "access": { "enum": ["read_only", "workspace_write"] },
          "toolPolicy": { "$ref": "#/$defs/toolPolicy" }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$" },
    "toolPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspace", "webSearch", "mcpServers"],
      "properties": {
        "workspace": { "enum": ["none", "read", "write"] },
        "webSearch": { "type": "boolean" },
        "mcpServers": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
      }
    }
  }
}
