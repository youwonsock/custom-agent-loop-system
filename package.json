{
  "name": "custom-agent-loop-system",
  "version": "3.4.1",
  "description": "Dynamic multi-model multi-session orchestrator that controls an interactive coding CLI (opencode) as child processes to autonomously achieve goals.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/youwonsock/Custom_AgentLoopSystem.git"
  },
  "bugs": {
    "url": "https://github.com/youwonsock/Custom_AgentLoopSystem/issues"
  },
  "homepage": "https://github.com/youwonsock/Custom_AgentLoopSystem#readme",
  "type": "commonjs",
  "main": "dist/loop_orchestrator.js",
  "bin": {
    "agent-loop": "dist/loop_orchestrator.js"
  },
  "scripts": {
    "prebuild": "node scripts/sync-runtime-defaults.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test --test-concurrency=1 dist/*.test.js",
    "coverage": "npm run build && node --test --test-concurrency=1 --experimental-test-coverage --test-coverage-include=dist/*.js --test-coverage-exclude=dist/*.test.js --test-coverage-lines=80 --test-coverage-branches=60 --test-coverage-functions=70 dist/*.test.js",
    "smoke": "npm run build && node dist/loop_orchestrator.js --help",
    "bundle:extension-core": "npm run build && node scripts/bundle-core-for-vsix.js",
    "pack:check": "npm run build && node scripts/verify-npm-package.js",
    "verify:vsix": "node scripts/verify-vsix-package.js",
    "checksum:artifacts": "node scripts/checksum-artifacts.js",
    "sbom": "node scripts/generate-sbom.js",
    "generated:check": "node scripts/check-generated-files.js",
    "prestart": "npm run build",
    "start": "node dist/loop_orchestrator.js",
    "preinit": "npm run build",
    "init": "node dist/loop_orchestrator.js init",
    "prepack": "npm run build",
    "postinstall": "node scripts/fix-pty-permissions.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@openai/codex": "^0.146.0",
    "fs-extra": "^11.2.0",
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0"
  }
}
