{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Loop Pipeline",
  "type": "object",
  "required": ["version", "name", "startStageId", "interruptStageId", "reentryStageId", "iterationCompletionStageId", "roles", "stages"],
  "properties": {
    "version": { "const": 1 },
    "name": { "type": "string", "minLength": 1 },
    "startStageId": { "$ref": "#/$defs/id" },
    "interruptStageId": { "$ref": "#/$defs/id" },
    "reentryStageId": { "$ref": "#/$defs/id" },
    "iterationCompletionStageId": { "$ref": "#/$defs/id" },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "modelRole", "description", "instructions"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "modelRole": {
            "enum": ["planner", "implementer", "tester", "qa_lead", "master", "interrupter"]
          },
          "description": { "type": "string" },
          "instructions": { "type": "string" },
          "model": { "type": "string", "minLength": 1 },
          "variant": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id", "name", "role", "kind", "instructions", "onSuccess", "onFailure",
          "countsIteration", "requiresPlanApproval", "planOptionsCount"
        ],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "name": { "type": "string", "minLength": 1 },
          "role": { "$ref": "#/$defs/id" },
          "kind": {
            "enum": ["planning", "implementation", "test", "review", "approval", "interrupt"]
          },
          "instructions": { "type": "string" },
          "onSuccess": { "type": "string", "minLength": 1 },
          "onFailure": { "type": "string", "minLength": 1 },
          "countsIteration": { "type": "boolean" },
          "requiresPlanApproval": { "type": "boolean" },
          "planOptionsCount": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    }
  },
  "additionalProperties": false
}
