{
  "name": "custom-agent-loop-system",
  "version": "4.0.0",
  "description": "Local agent graph editor and resilient coding CLI orchestrator",
  "type": "commonjs",
  "main": "dist/src/server/cli.js",
  "bin": {
    "agent-loop": "dist/src/server/cli.js"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "build:launcher:mac": "node scripts/build-macos-launcher.js",
    "typecheck": "tsc --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "npm run build && node --test --test-reporter=tap --test-concurrency=1 dist/src/core/*.test.js dist/src/server/*.test.js",
    "test:tooling": "node --test test/tooling/*.test.cjs",
    "test:e2e": "playwright test",
    "test:launcher:mac": "node --test test/desktop-launcher.test.cjs",
    "test:vm": "node --test dist/src/core/program_io.test.js",
    "verify:platform": "node scripts/run-verification.js platform",
    "verify:browser": "node scripts/run-verification.js browser",
    "verify:vm": "node scripts/run-verification.js vm",
    "sandbox:prepare": "npm run build && node dist/src/core/program_io_setup.js",
    "coverage": "npm run build && node --test --test-concurrency=1 --experimental-test-coverage --test-coverage-include=dist/src/core/*.js --test-coverage-exclude=dist/src/core/*.test.js dist/src/core/*.test.js dist/src/server/*.test.js",
    "prestart": "npm run build",
    "start": "node dist/src/server/cli.js ui",
    "dev": "node scripts/dev.js",
    "smoke": "node dist/src/server/cli.js --help",
    "pack:check": "node scripts/verify-npm-package.js",
    "prepack": "npm run build",
    "postinstall": "node scripts/fix-pty-permissions.js",
    "pack:smoke": "node scripts/verify-installed-package.js",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.308",
    "@fastify/cookie": "^11.1.3",
    "@fastify/static": "^10.1.7",
    "fastify": "^5.12.7",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@xyflow/react": "^12.9.3",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "files": [
    "dist",
    "README.md",
    "docs/AUTONOMOUS_WORKFLOW.md",
    "docs/EXECUTION_CONDITIONS.md",
    "scripts/fix-pty-permissions.js"
  ]
}
